{{ ansible_managed | comment }}

{# the default aliases win over host aliases with the same name #}
{% for alias, list in (_postfix_aliases | combine(_postfix_default_aliases)).items() %}
{% if list %}
{{ "%-24s" | format(alias + ":") }} {{ list | join(", ") }}
{% else %}
{{ "%-24s" | format(alias + ":") }} {{ _postfix_default_alias_recipients | join(", ") }}
{% endif %}
{% endfor %}
